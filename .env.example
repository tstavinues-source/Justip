# Salin berkas ini menjadi .env lalu isi dari proyek Supabase Justip:
# Settings → API → Project URL dan anon public key.
# Kunci anon memang kunci publik untuk browser; keamanan data diatur RLS
# (lihat supabase/schema.sql). JANGAN pernah memakai service_role key di sini.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
